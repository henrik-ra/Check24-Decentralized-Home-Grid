# Travel Web Environment Configuration
# Copy this file to .env.local and replace with your actual Azure URLs

# Speedboat Travel API Base URL (deployed to Azure Container Apps)
# Get your URL with: az containerapp list --query "[?contains(name, 'speedboat-travel')].properties.configuration.ingress.fqdn" -o tsv
VITE_API_BASE_URL=https://c24-speedboat-travel-xyz.westeurope.azurecontainerapps.io

# For local Docker development (uncomment):
# VITE_API_BASE_URL=http://localhost:3001
